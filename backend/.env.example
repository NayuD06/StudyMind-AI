NODE_ENV=development
PORT=4000

# MySQL chạy bằng docker-compose ở thư mục gốc (cổng 3307 trên máy).
# Mật khẩu phải trùng MYSQL_PASSWORD trong file .env ở thư mục gốc.
DATABASE_URL="mysql://studymind:MAT_KHAU@localhost:3307/studymind"
# Database phụ cho lệnh prisma migrate dev (cùng mật khẩu)
SHADOW_DATABASE_URL="mysql://studymind:MAT_KHAU@localhost:3307/studymind_shadow"

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""

# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# AI service (FastAPI). Khóa phải trùng INTERNAL_API_KEY trong ai-service/.env
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_KEY=""

# Thư mục lưu PDF khi phát triển
UPLOAD_DIR="uploads"

# Tài khoản quản trị viên đầu tiên, tạo bằng lệnh: npm run db:seed
ADMIN_NAME="Quản trị viên"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
