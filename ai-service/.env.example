QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks

# Đổi sang intfloat/multilingual-e5-small nếu máy yếu
EMBEDDING_MODEL=BAAI/bge-m3

# Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Khóa nội bộ: chỉ backend biết. Phải trùng AI_SERVICE_KEY trong backend/.env
INTERNAL_API_KEY=
