# Sao chép thành .env rồi đặt mật khẩu ngẫu nhiên, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ----- Chỉ cần khi chạy bản đóng gói: docker compose --profile app up -d --build -----
# Hai chuỗi ngẫu nhiên, mỗi chuỗi tối thiểu 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Phải trùng INTERNAL_API_KEY trong ai-service/.env
AI_SERVICE_KEY=
# Địa chỉ người dùng gõ trên trình duyệt (đổi khi có tên miền thật)
APP_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081
# Gửi thư đặt lại mật khẩu; bỏ trống SMTP_HOST thì thư chỉ in ra log của backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Quản trị viên đầu tiên, tạo bằng: docker compose exec backend npm run db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
